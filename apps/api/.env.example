# ---------- API ----------
PORT=4000
JWT_SECRET=change-me-in-production
# คั่นหลาย origin ด้วย , หรือ * เพื่อให้เปิดจาก iPad ในวง LAN ได้ (API ใช้ Bearer token ไม่ใช้ cookie)
WEB_ORIGIN=*

# ---------- Image source ----------
# local     = เก็บไฟล์ DICOM ในโฟลเดอร์ data/dicom (ใช้เดโมโดยไม่ต้องต่อ PACS)
# dcm4chee  = proxy ไป dcm4chee-arc ผ่าน DICOMweb (QIDO-RS / WADO-URI / STOW-RS)
IMAGE_SOURCE=local

# DICOMweb base ของ dcm4chee (ลงท้ายด้วย /rs)
DCM4CHEE_RS_URL=http://localhost:8080/dcm4chee-arc/aets/DCM4CHEE/rs
# อ่านอย่างเดียว (ค่าเริ่มต้น true) — ตั้งเป็น false เมื่อต้องการให้อัปโหลด/seed เขียนลง PACS ได้
DCM4CHEE_READ_ONLY=true
# WADO-URI (ถ้าไม่กำหนด จะใช้ DCM4CHEE_RS_URL แล้วเปลี่ยน /rs เป็น /wado)
DCM4CHEE_WADO_URL=

# Auth ไป dcm4chee (เลือกอย่างใดอย่างหนึ่ง หรือเว้นว่างถ้าไม่เปิด security)
# 1) Bearer token แบบคงที่
DCM4CHEE_TOKEN=
# 2) Keycloak client credentials
DCM4CHEE_KC_TOKEN_URL=
DCM4CHEE_KC_CLIENT_ID=
DCM4CHEE_KC_CLIENT_SECRET=
